DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_dev
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
# No refresh-token flow exists yet, so JWT_REFRESH_SECRET is not currently used.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
PUBLIC_ORDER_RATE_LIMIT_MAX=10
PUBLIC_ORDER_RATE_LIMIT_WINDOW=10 minutes
TRUST_PROXY=false
LOG_LEVEL=info

# Sentry is optional. Cloudinary is required for direct owner photo uploads.
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set these only when intentionally running the one-time idempotent seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
